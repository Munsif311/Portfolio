SESSION_SECRET=replace-with-a-long-random-secret
# Connect a Vercel Blob store for uploads and durable portfolio data.
# For local development, use `vercel env pull` to populate this from the connected project.
BLOB_READ_WRITE_TOKEN=
# Keep this stable across deployments; it encrypts the portfolio JSON stored in Blob.
PORTFOLIO_DATA_SECRET=replace-with-a-different-long-random-secret
# Optional: configure a verified sender in Resend to enable password reset emails.
RESEND_API_KEY=
ADMIN_FROM_EMAIL=
# Optional override for the first admin email; defaults to the portfolio contact email.
ADMIN_SETUP_EMAIL=
